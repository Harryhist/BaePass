# Copy to .env, fill in, then load it:  set -a; source .env; set +a
GMAIL_ADDR='you@gmail.com'
GMAIL_APP_PASSWORD='abcdefghijklmnop'
SENDER='noreply@yourchatsite.com'
ALLOWED_HOST='yourchatsite.com'
# python -c "from werkzeug.security import generate_password_hash as g; print(g('4821'))"
FRIEND_PIN_HASH='scrypt:...'
# python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY='change-me'
# Optional: shows an "Open the chat" button after a successful verify
CHAT_URL='https://yourchatsite.com'
# Bind to 127.0.0.1 or your Tailscale IP, never 0.0.0.0
BIND_HOST='127.0.0.1'
# Set to 1 once you serve it over HTTPS (e.g. tailscale serve)
COOKIE_SECURE='0'
